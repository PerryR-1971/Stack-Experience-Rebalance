!!VRy10:S0;                             [Base value is zero, meaning no rank starts from nothing]

****************
*Health settings in percent 

!!SN:W^Exp_Health_Set^/?y1;             [Get value in y1]
!!VRy2&y1=1:S0; !!VRy2&y1=2:S10; !!VRy2&y1=3:S20; !!VRy2&y1=4:S30; !!VRy2&y1=5:S40; !!VRy2&y1=6:S50; !!VRy2&y1=7:S60; !!VRy2&y1=8:S70; !!VRy2&y1=9:S80; !!VRy2&y1=10:S90; !!VRy2&y1=11:S100; !!VRy2&y1=12:S150; !!VRy2&y1=13:S200;
!!VRy1:Sy2:10;

!!re i/0/9;
    !!VRy99:S20+i;                      [Fill variables from y20 till y29]
    !!VRyy99:Sy1*i+y1;                  [Add 5% increment]
!!en;
****************


****************
*Attack and Defense settings in flat value

!!SN:W^Exp_Att_Def_Set^/?y1;            [Get value in y1]
!!VRy2&y1=1:S0; !!VRy2&y1=2:S10; !!VRy2&y1=3:S20; !!VRy2&y1=4:S30; !!VRy2&y1=5:S40; !!VRy2&y1=6:S50; !!VRy2&y1=7:S60; !!VRy2&y1=8:S70; !!VRy2&y1=9:S80; !!VRy2&y1=10:S90; !!VRy2&y1=11:S100; !!VRy2&y1=12:S150; !!VRy2&y1=13:S200;
!!VRy1:Sy2:10;

!!re i/0/9;
    !!VRy99:S30+i;                      [Fill variables from y20 till y29]
    !!VRyy99:Sy1*i+y1:10;               [Add flat increment]
!!en;
****************


****************
*Min and Max Damage settings in percent

!!SN:W^Exp_MinMax_Damage_Set^/?y1;      [Get value in y1]
!!VRy2&y1=1:S0; !!VRy2&y1=2:S10; !!VRy2&y1=3:S20; !!VRy2&y1=4:S30; !!VRy2&y1=5:S40; !!VRy2&y1=6:S50; !!VRy2&y1=7:S60; !!VRy2&y1=8:S70; !!VRy2&y1=9:S80; !!VRy2&y1=10:S90; !!VRy2&y1=11:S100; !!VRy2&y1=12:S150; !!VRy2&y1=13:S200;
!!VRy1:Sy2:10;

!!re i/0/9;
    !!VRy99:S40+i;                      [Fill variables from y20 till y29]
    !!VRyy99:Sy1*i+y1;                  [Add % increment]
!!en;
****************


****************
*Speed in percent value

!!SN:W^Exp_Speed_Set^/?y1;              [Get value in y1]
!!VRy2&y1=1:S0; !!VRy2&y1=2:S10; !!VRy2&y1=3:S20; !!VRy2&y1=4:S30; !!VRy2&y1=5:S40; !!VRy2&y1=6:S50; !!VRy2&y1=7:S60; !!VRy2&y1=8:S70; !!VRy2&y1=9:S80; !!VRy2&y1=10:S90; !!VRy2&y1=11:S100; !!VRy2&y1=12:S150; !!VRy2&y1=13:S200;
!!VRy1:Sy2:10;

!!re i/0/9;
    !!VRy99:S50+i;                      [Fill variables from y20 till y29]
    !!VRyy99:Sy1*i+y1;                  [Add % increment]
!!en;
