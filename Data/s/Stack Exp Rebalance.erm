!#SN:W^Stack_Exp_Rebalance_Mod_Active^/1; [Set the mod active]

****************************************************************************************************
*STACK EXPERIENCE REBALANCE MOD
*Author: modified by Perry, 2020
*
*EA:B ability reference
*Format: EA<creature>:B<slot>/1/<effect code>/<modifier>/R0/R1/.../R10;
*
*Modifier codes
*  Add (+)      = 43
*  Set (=)      = 61
*  Percent (%)  = 37
*
*Effect                                  Code
*  Attack                                  65
*  Block                                   66
*  Reduce casting cost                     67
*  Defense                                 68
*  Death Stare                             69
*  Fear                                    70
*  Santa Gremlin guards                    71
*  Health                                  72
*  Cast advanced spell before attack       74
*  Cast advanced spell after attack        75
*  Deflect                                 76
*  Maximum damage                          77
*  Number of shots                         79
*  Number of spell castings                80
*  Retaliations                            82
*  Speed                                   83
*  Multiple summon                         85
*  Magic resistance                        87
*  Cast spell after melee attack           97
*  Reduce target defense                   98
*  Cast non-direct spell after attack      99
*  Defending bonus                        100
*  Death Blow                             101
*  Flagged abilities                      102
*  Golem-style damage resistance          103
*  Hatred damage                          104
*  No range penalty                       105
*  Cast basic spell before attack         106
*  Cast basic spell after attack          107
*  Summon Clone                           108
*  Minimum damage                         109
*  No obstacle penalty                    111
*  Cast spell before attack               112
*  Regeneration                           114
*  Enchant with spell                     115
*  Single summon                          117
*  Spell immunity                         119
****************************************************************************************************

****************************************************************************************************
*ON GAME ENTER
*1. Normalize all configuration values.
*2. Apply the selected stat progression tables.
*3. Remove old ability rows for enabled ability packages.
*4. Assign the selected replacement abilities.

!?FU(OnGameEnter);
!!SN:W^Stack_Exp_Rebalance_On^/?y99; !!FU&y99=0:E; [Check if option was activated and Exit if not]
!!FU(Stack_Exp_Normalize_Settings):P; [Ensure all four progression selectors use a valid preset]

!!SN:W^Exp_WoG_Stats^/?y97;             [WoG stat progression option]
!!SN:W^Exp_WoG_Abilities^/?y96;         [WoG faction ability option]
!!SN:W^Exp_WoG_Neutrals^/?y94;          [WoG neutral ability option]

*Explicit WoG neutral creature list
!!SN:M(M_AUTO_ID)/0/(M_INT)/(M_TRIGGER_LOCAL)/?y93;
!!FU(Array_Push):Py93/132/133/134/135/136/137/138/139/140/141/142/143/144;
!!FU(Array_Push):Py93/159/160/161/162/163/164/165/166/167/168/169/170/171/172/173;
!!FU(Array_Push):Py93/192/193/194/195/196;

*Apply stat tables and clear old ability rows for enabled packages
!!FU(Stack_Experience_Rebalance_Fkt):P0/131/y97/y96/0/0;      [WoG faction creatures]
!!FU(Stack_Experience_Rebalance_Fkt):P132/196/y97/0/y93/y94;  [WoG neutrals and remaining WoG IDs]
!!FU(Stack_Experience_Rebalance_Fkt):P150/158/0/y96/0/0;      [WoG level 8 faction creatures]

*Assign the selected WoG ability packages
!!FU(Stack_Exp_Apply_WoG_Faction_Abilities)&y96=1:P;
!!FU(Stack_Exp_Apply_WoG_Neutral_Abilities)&y94=1:P;

!!SN:W^Legacy_of_the_Silence_Active^/?y91;
!!if&y91=1;                             [Prevent overlapping TUM creature IDs from being modified]
    !!SN:W^Exp_TUM_Stats^/0;
    !!SN:W^Exp_TUM_Abilities^/0;
    !!SN:W^Exp_TUM_Neutrals^/0;
!!en;

!!SN:W^Typhon_Third_Upgrade_Mod_Active^/?y90;
!!if&y90=1/y91=0; 
    [Explicit list from TUM's own neutral creature constants. Do not use MA:O because TUM assigns a town to some neutral upgrade chains dynamically.]
    !!SN:M(M_AUTO_ID)/0/(M_INT)/(M_TRIGGER_LOCAL)/?y95;
    !!FU(Array_Push):Py95/253/254/258/259/260/262/263/264/265/266/267/268;
    !!FU(Array_Push):Py95/286/287/288/289/290/292/294/295/296/297/298/299;
    !!FU(Array_Push):Py95/300/301/302/303/304/305/306/307/308/309/310/311;
    !!FU(Array_Push):Py95/312/313/314/315/316/317/318/319/322/323/324/325;
    !!FU(Array_Push):Py95/326/327/328/330/331/332/333/334/335/336/337/338;
    !!FU(Array_Push):Py95/339/340/341/342/343/344/345/346/347;

    !!SN:W^Exp_TUM_Stats^/?y97;   [Check option for TUM rebalanced stats]
    !!SN:W^Exp_TUM_Abilities^/?y96;[Check option for TUM rebalanced abilities]
    !!SN:W^Exp_TUM_Neutrals^/?y94;[Check option for TUM neutral abilities]
    !!FU(GetMaxMonsterId):P?y1;     [Use the current creature limit instead of a fixed TUM ID]
    !!FU(Stack_Experience_Rebalance_Fkt):P197/y1/y97/y96/y95/y94; [TUM creature IDs begin after the WoG Dracolich at ID 196]

    !!SN:W^Typhon_Third_Upgrade_Mod_Active^/?y98; 
    !!FU(Set_Monster_Special_Text)&y98=1/y96=1:P; [add changed specialty text if option is enabled]
!!en;

!!SN:W^Typhon_Third_Upgrade_Mod_Active^/?y99; !!FU|y99=0/y91=1:E; [Exit TUM ability package when unavailable or blocked]


